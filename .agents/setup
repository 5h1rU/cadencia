#!/usr/bin/env bash
# Prepares an Amp orb (Debian 12, x86_64) to build and test CadenciaCore.
# The iOS app target needs Xcode on macOS and cannot be built here.
set -euo pipefail

SWIFT_VERSION="6.0.3"
SWIFT_HOME="$HOME/swift"
SWIFT_BIN="$SWIFT_HOME/usr/bin"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

log() { printf '[setup %s] %s\n' "$(date +%T)" "$*"; }

# 1. System libraries the Swift toolchain needs at runtime/link time.
needed=(binutils gnupg2 libc6-dev libcurl4-openssl-dev libedit2 libgcc-12-dev libpython3-dev libsqlite3-0 libstdc++-12-dev libxml2-dev libz3-dev pkg-config tzdata unzip zlib1g-dev)
missing=()
for p in "${needed[@]}"; do dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p"); done
if [ "${#missing[@]}" -gt 0 ]; then
  log "installing apt packages: ${missing[*]}"
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
else
  log "apt packages present"
fi

# 2. Swift toolchain (static tarball from swift.org), installed under ~/swift.
if [ -x "$SWIFT_BIN/swift" ] && "$SWIFT_BIN/swift" --version 2>&1 | grep -q "Swift version $SWIFT_VERSION"; then
  log "swift $SWIFT_VERSION present"
else
  log "downloading swift $SWIFT_VERSION"
  tmp="$(mktemp -d)"
  url="https://download.swift.org/swift-${SWIFT_VERSION}-release/debian12/swift-${SWIFT_VERSION}-RELEASE/swift-${SWIFT_VERSION}-RELEASE-debian12.tar.gz"
  curl -fsSL "$url" -o "$tmp/swift.tar.gz"
  rm -rf "$SWIFT_HOME"
  mkdir -p "$SWIFT_HOME"
  tar -xzf "$tmp/swift.tar.gz" -C "$SWIFT_HOME" --strip-components=1
  rm -rf "$tmp"
  "$SWIFT_BIN/swift" --version
fi

# 3. Make swift available to Amp and supervised services (login shells).
marker="# Cadencia: Swift toolchain"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport PATH="%s:$PATH"\n' "$marker" "$SWIFT_BIN" >> "$HOME/.bash_profile"
  log "added swift to ~/.bash_profile"
fi

# 4. Warm the package build so the first `swift test` in a thread is fast.
log "building CadenciaCore (debug, with tests)"
( cd "$REPO_ROOT/CadenciaCore" && PATH="$SWIFT_BIN:$PATH" swift build --build-tests )

log "done"

        }
      }
    },
    "Your coach is thinking…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenador está pensando…"
          }
        }
      }
    },
    "Your coach looks at six months of Intervals.icu rides, climbing, power and feedback to explain your strengths and the kind of cyclist you're becoming." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenador analiza seis meses de rodadas, ascenso, potencia y sensaciones en Intervals.icu para explicarte tus fortalezas y el tipo de ciclista en el que te estás convirtiendo."
          }
        }
      }
    },
    "Your coach needs attention" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu coach necesita atención"

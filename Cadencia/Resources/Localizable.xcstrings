        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experiencia con terreno y altitud"
          }
        }
      }
    },
    "The category describes the climb’s geometry. Your preparation also depends on altitude, conditions and where the climb falls in the event." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La categoría describe la geometría de la subida. Tu preparación también depende de la altitud, las condiciones y su ubicación dentro del evento."
          }
        }
      }
    },
    "The coach connection needs attention. Your saved profile is still available if you have one." : {
      "localizations" : {
        "es" : {

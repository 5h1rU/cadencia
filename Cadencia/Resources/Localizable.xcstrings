    "%lld pending uploads are kept and resume when you reconnect this athlete.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan %lld subidas pendientes y se reanudan cuando reconectes este atleta."
          }
        }
      }
    },
    "%lld rides have not reached Intervals yet. They stay on this phone and upload when the same athlete signs back in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld rodadas aún no han llegado a Intervals. Se quedan en este teléfono y se suben cuando el mismo atleta vuelva a iniciar sesión."
          }
        }
      }
    },

    "Your preparation" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu preparación"
          }
        }
      }
    },
    "Your recent rides give us a starting point." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus rodadas recientes nos dan un punto de partida."
          }
        }
      }
    },
    "Your recent rides give us a starting point. We can fill in the missing details as we talk." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus rodadas recientes nos dan un punto de partida. Podemos completar los detalles que falten mientras hablamos."
          }
        }
      }
    },
    "Your recorded GPS route appears here after the activity syncs. A planned route is not required." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",

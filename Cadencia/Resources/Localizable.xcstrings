        }
      }
    },
    "Take it easy in today's session." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy toca una sesión suave."
          }
        }
      }
    },
    "Tap a climb for its gradient profile, hardest sections and kilometre splits. Categories are estimates, not official race classifications." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una subida para ver su perfil de pendientes, los tramos más exigentes y el desglose por kilómetro. Las categorías son estimaciones, no clasificaciones oficiales de la carrera."
          }
        }
      }
    },

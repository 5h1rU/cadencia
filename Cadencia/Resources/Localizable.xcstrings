        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu consulta"
          }
        }
      }
    },
    "Your credential lives only in this phone's Keychain." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",

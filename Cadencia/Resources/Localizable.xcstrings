    },
    "Tell the coach what changed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale al coach qué cambió"
          }
        }
      }
    },
    "Tell your coach what you want from your riding. We’ll shape a plan around your history, your week and the training you want to include." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale al entrenador qué quieres lograr. Armaremos un plan según tu historial, tu semana y las actividades que quieras incluir."
          }
        }
      }
    },

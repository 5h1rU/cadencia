  "strings": {
    "–": {},
    "·": {},
    "· %lld %%": {},
    "“Saturday I have a 120 km group ride.” “Only 45 minutes on Thursday.” “Legs are heavy.” The week adapts; the long-range plan stays.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“El sábado tengo una rodada en grupo de 120 km.” “El jueves solo tengo 45 minutos.” “Piernas pesadas.” La semana se adapta; el plan a largo plazo se mantiene."
          }
        }
      }
    },
    "%@": {},

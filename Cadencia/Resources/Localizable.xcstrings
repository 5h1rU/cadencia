        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu evento"
          }
        }
      }
    },
    "Your expected duration exceeds the cutoff. Review your objective and the event’s time limit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu duración estimada supera el tiempo límite. Revisa tu objetivo y el límite del evento."
          }
        }
      }
    },
    "Your future cycling sessions will follow this plan. Completed rides stay in your history." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus próximas sesiones de ciclismo seguirán este plan. Las rodadas completadas seguirán en tu historial."
          }
        }
      }
    },
    "Your goal" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo"
          }
        }
      }
    },
    "Your Intervals.icu data, a daily prescription, and a trainer that listens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de Intervals.icu, una prescripción diaria y un rodillo que escucha."
          }
        }
      }
    },
    "Your plan makes room for CrossFit and keeps your long ride on Sunday." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan incluye CrossFit y mantiene la rodada larga el domingo."

# Copy to web/.env (never committed) and fill in.

# Cloudflare, for `alchemy deploy`. Or connect a profile with `npx alchemy profile edit`.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# The OAuth app created at https://intervals.icu/settings for Cadencia web.
# Its redirect URI is <app origin>/auth/intervals/callback.
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
# The app's Webhook Secret in Intervals; its webhook URL is <api origin>/webhooks/intervals (CALENDAR_UPDATED).
INTERVALS_WEBHOOK_SECRET=
